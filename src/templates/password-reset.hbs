<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{subject}}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .container {
            border: 1px solid #e0e0e0;
            border-radius: 5px;
            padding: 20px;
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
        }
        .header img {
            max-width: 150px;
        }
        .otp-code {
            background-color: #f5f5f5;
            padding: 15px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            letter-spacing: 5px;
            margin: 20px 0;
            border-radius: 5px;
        }
        .message {
            margin-bottom: 20px;
        }
        .footer {
            font-size: 12px;
            text-align: center;
            color: #666;
            margin-top: 30px;
            padding-top: 10px;
            border-top: 1px solid #e0e0e0;
        }
        .warning {
            color: #c0392b;
            font-size: 14px;
            margin-top: 20px;
        }
        .steps {
            background-color: #f9f9f9;
            padding: 15px;
            border-radius: 5px;
            margin: 20px 0;
        }
        .steps ol {
            margin-left: 20px;
            padding-left: 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <img src="{{logoUrl}}" alt="{{companyName}} Logo">
            <h1>{{subject}}</h1>
        </div>
        
        <div class="message">
            <p>Hello {{name}},</p>
            <p>We received a request to reset your password. Use the following verification code to complete the process:</p>
            
            <div class="otp-code">{{otpCode}}</div>
            
            <div class="steps">
                <p><strong>To reset your password:</strong></p>
                <ol>
                    <li>Enter this code on the password reset page</li>
                    <li>Create a new password</li>
                    <li>Confirm your new password</li>
                </ol>
            </div>
            
            <p>This code will expire in {{expiryTime}} minutes.</p>
            
            <p class="warning">If you didn't request a password reset, please ignore this email or contact our support team immediately.</p>
        </div>
        
        <div class="footer">
            <p>&copy; {{year}} {{companyName}}. All rights reserved.</p>
            <p>If you need assistance, please contact us at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a></p>
        </div>
    </div>
</body>
</html>
