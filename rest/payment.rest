### Funz Gateway Webhook
# Webhook URL: https://api.abamba.com.ng/api/v1/payments/webhook/funz
# Event: transaction.update (fired when payment status changes)
# Only processes when status is COMPLETED
POST {{baseUrl}}/payments/webhook/funz
Content-Type: application/json

{
  "event": "transaction.update",
  "status": "COMPLETED",
  "data": {
    "id": "01knptgq31gsdb6y998np3ejgy",
    "amount": "13590.00",
    "fee": "271.80",
