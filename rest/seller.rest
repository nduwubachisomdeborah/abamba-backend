  "amount": 50000,
  "description": "Monthly payout request"
}

### Get all payouts
GET {{baseUrl}}/seller/payouts
Authorization: Bearer {{authToken}}

### Get seller transactions
GET {{baseUrl}}/seller/transactions
Authorization: Bearer {{authToken}}
