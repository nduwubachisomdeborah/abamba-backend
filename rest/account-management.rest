### Get Account Status (Self)
# User checks their own account status
GET {{baseUrl}}/users/6832a4b7f12345678912345h/status
Authorization: Bearer {{userAuthToken}}

### Get Account Status (Admin)
# Admin checks any user's account status
GET {{baseUrl}}/users/6832a4b7f12345678912345h/status
Authorization: Bearer {{adminAuthToken}}

### Disable Account (Self)
# User disables their own account
PATCH {{baseUrl}}/users/6832a4b7f12345678912345h/disable
Content-Type: application/json
Authorization: Bearer {{userAuthToken}}

{
  "reason": "Taking a break from the platform"
}

### Disable Account (Admin)
# Admin disables any user's account
PATCH {{baseUrl}}/users/6832a4b7f12345678912345h/disable
Content-Type: application/json
Authorization: Bearer {{adminAuthToken}}

{
  "reason": "Account violated platform terms of service - multiple spam reports"
}

### Enable Account (Admin Only)
# Only admins can enable accounts
PATCH {{baseUrl}}/users/6832a4b7f12345678912345h/enable
Authorization: Bearer {{adminAuthToken}}

### Enable Account (Unauthorized - User)
# Regular users cannot enable accounts (this should fail)
PATCH {{baseUrl}}/users/6832a4b7f12345678912345h/enable
Authorization: Bearer {{userAuthToken}}

### Enable Account (Unauthorized - Seller)
# Sellers cannot enable accounts (this should fail)
PATCH {{baseUrl}}/users/6832a4b7f12345678912345h/enable
Authorization: Bearer {{sellerAuthToken}}

### Disable Another User's Account (Unauthorized)
# Regular users cannot disable other users' accounts (this should fail)
PATCH {{baseUrl}}/users/6832a4b7f12345678912345i/disable
Authorization: Bearer {{userAuthToken}}

### Check Status of Another User's Account (Unauthorized)
# Regular users cannot check other users' account status (this should fail)
GET {{baseUrl}}/users/6832a4b7f12345678912345i/status
Authorization: Bearer {{userAuthToken}}
